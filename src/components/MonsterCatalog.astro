---
import Layout from '../layouts/Layout.astro';
import Icon from './Icon.astro';
import ElementIcon from './ElementIcon.astro';
import type { Element } from '../lib/types';
import MonsterCard from './MonsterCard.astro';
import { monsters } from '../data/catalog';
import metadata from '../data/monsters-meta.json';
import {
  PAGE_SIZE,
  elementLabelsFor,
  attributeLabelsFor,
  filterMonsters,
  readMonsterFilters,
  catalogPageUrl,
  catalogElementOptions,
  leaderScopeOptionsFor,
  toMonsterSummary,
} from '../lib/monster-catalog';
import { getMessages, numberLocale, routePath, type Locale } from '../i18n';
interface Props {
  page?: number;
  locale?: Locale;
}
const { page = 1, locale = 'en' } = Astro.props;
const messages = getMessages(locale);
const elementLabels = elementLabelsFor(locale);
const attributeLabels = attributeLabelsFor(locale);
const leaderScopeOptions = leaderScopeOptionsFor(locale);
const monsterIndex = monsters.map(toMonsterSummary);
const sorted = filterMonsters(
  monsterIndex,
  readMonsterFilters(new URLSearchParams()),
  locale,
);
const totalPages = Math.ceil(sorted.length / PAGE_SIZE);
const entries = sorted.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE);
const updated = new Date(metadata.importedAt).toLocaleDateString(
  numberLocale(locale),
  {
    timeZone: 'UTC',
  },
);
const clientConfig = JSON.stringify({
  locale,
  elementLabels,
  messages: {
    view: locale === 'pt-BR' ? 'Ver' : 'View',
    element: messages.monsters.element,
    naturalStars: messages.monsters.naturalStars.toLowerCase(),
    results: messages.monsters.results,
    page: messages.monsters.page,
    of: messages.monsters.of,
    searching:
      locale === 'pt-BR' ? 'Buscando monstros…' : 'Searching monsters…',
    searchUnavailable:
      locale === 'pt-BR'
        ? 'Busca indisponível. Você pode tentar novamente.'
        : 'Search unavailable. You can try again.',
    secondAwakening: messages.monster.secondAwakening,
    noLeaderSkill: messages.monster.noLeaderSkill,
  },
}).replaceAll('<', '\\u003c');
---

<Layout
  title={messages.monsters.title}
  section="monsters"
  description={messages.monsters.description}
  locale={locale}
  routeName={page > 1 ? 'monsterPage' : 'monsters'}
  routeParams={page > 1 ? { page } : {}}
>
  <section class="page-intro">
    <div>
      <span class="eyebrow">
        <span class="eyebrow-mark"></span> {messages.monsters.eyebrow}
      </span>
      <h1>
        {messages.monsters.headingPrefix}{' '}
        <span>{messages.monsters.headingAccent}</span>
      </h1>
      <p>{messages.monsters.intro}</p>
    </div>
    <div class="intro-emblem" aria-hidden="true">
      <Icon name="book" size={60} />
    </div>
  </section>
  <div class="bestiary-summary">
    <span>
      <strong>{monsters.length.toLocaleString(numberLocale(locale))}</strong>{' '}
      {messages.monsters.obtainable}
    </span>
    <span>
      {messages.monsters.updated} {updated}
    </span>
  </div>
  <section
    aria-label={messages.monsters.explore}
    data-monster-catalog
    data-page={page}
  >
    <form
      class="bestiary-filters"
      role="search"
      action={routePath('monsters', locale)}
      data-monster-filters
    >
      <div class="search-box">
        <Icon name="search" size={20} />
        <label class="sr-only" for="monster-catalog-search">
          {messages.monsters.searchLabel}
        </label>
        <input
          id="monster-catalog-search"
          type="search"
          name="q"
          placeholder={messages.monsters.searchPlaceholder}
          maxlength="200"
          autocomplete="off"
        />
        <button
          class="search-clear-button"
          type="button"
          aria-label={messages.common.clearSearch}
          title={messages.common.clearSearch}
          data-search-clear
        >
          <Icon name="close" size={16} />
        </button>
      </div>
      <div class="bestiary-selects">
        <label>
          {messages.monsters.element}
          <select name="element">
            <option value="">{messages.common.all}</option>
            {catalogElementOptions.map(([value, name]) => (
              <option value={value}>{name}</option>
            ))}
          </select>
        </label>
        <label>
          {messages.monsters.naturalStars}
          <select name="stars">
            <option value="">{messages.common.all}</option>
            {[1, 2, 3, 4, 5].map((n) => (
              <option value={n}>
                {n}★ {messages.monsters.naturalStars.toLowerCase()}
              </option>
            ))}
          </select>
        </label>
        <label>
          {messages.monsters.leaderSkill}
          <select name="leader">
            <option value="">{messages.common.all}</option>
            <option value="any">{messages.monsters.withLeader}</option>
            <option value="none">{messages.monsters.withoutLeader}</option>
            {Object.entries(attributeLabels).map(([value, name]) => (
              <option value={value}>{name}</option>
            ))}
          </select>
        </label>
        <label>
          {messages.monsters.leaderContent}
          <select name="leaderScope">
            <option value="">{messages.common.all}</option>
            {leaderScopeOptions.map(({ value, label }) => (
              <option value={value}>{label}</option>
            ))}
          </select>
        </label>
        <label>
          {messages.monsters.sortBy}
          <select name="sort">
            <option value="name">{messages.monsters.sortName}</option>
            <option value="stars">{messages.monsters.sortStars}</option>
            <option value="speed">{messages.monsters.sortSpeed}</option>
            <option value="hp">{messages.monsters.sortHp}</option>
            <option value="attack">{messages.monsters.sortAttack}</option>
            <option value="defense">{messages.monsters.sortDefense}</option>
          </select>
        </label>
      </div>
      <div class="bestiary-results-bar">
        <p data-monster-count role="status" aria-live="polite" tabindex="-1">
          {sorted.length.toLocaleString(numberLocale(locale))}{' '}
          {messages.monsters.results} · {messages.monsters.page} {page}{' '}
          {messages.monsters.of} {totalPages}
        </p>
        <button type="button" class="bestiary-clear" data-reset-monsters>
          {messages.common.clearFilters}
        </button>
      </div>
    </form>
    <noscript>
      <p class="notice">{messages.monsters.noScript}</p>
    </noscript>
    <div class="notice" data-monster-error hidden role="alert">
      {messages.monsters.loadError}{' '}
      <button type="button" class="bestiary-clear" data-retry-monsters>
        {messages.common.retry}
      </button>
    </div>
    <div class="bestiary-grid" data-monster-grid>
      {entries.map((monster) => (
        <MonsterCard monster={monster} locale={locale} />
      ))}
    </div>
    {Object.keys(elementLabels).map((element) => (
      <template data-element-icon={element}>
        <ElementIcon element={element as Element} />
      </template>
    ))}
    <div class="empty-state" data-monster-empty hidden>
      <Icon name="search" size={30} />
      <h2>{messages.monsters.noResults}</h2>
      <p>{messages.monsters.noResultsCopy}</p>
      <button type="button" class="button" data-reset-monsters>
        {messages.common.clearFilters}
      </button>
    </div>
    <nav
      class="bestiary-pagination"
      aria-label={messages.monsters.pagesLabel}
      data-monster-pagination
    >
      <a
        class="button button-secondary"
        href={catalogPageUrl(page - 1, locale)}
        data-page-prev
        hidden={page === 1}
      >
        ← {messages.monsters.previous}
      </a>
      <span data-page-label>
        {messages.monsters.page} {page} {messages.monsters.of} {totalPages}
      </span>
      <a
        class="button button-secondary"
        href={catalogPageUrl(page + 1, locale)}
        data-page-next
        hidden={page === totalPages}
      >
        {messages.monsters.next} →
      </a>
    </nav>
  </section>
  <aside class="catalog-note">
    <Icon name="info" size={18} />
    <p>
      {messages.monsters.sourceNotePrefix}{' '}
      <a href="https://swarfarm.com/" target="_blank" rel="noreferrer">
        SWARFARM ↗
      </a>
      . {messages.monsters.sourceNoteSuffix}
    </p>
  </aside>
  <script
    set:html={`window['__MONSTER_INDEX__'] = ${JSON.stringify(monsterIndex)}; window['__MONSTER_CATALOG_CONFIG__'] = ${clientConfig};`}
  ></script>
  <script>
    import '../scripts/monsters';
  </script>
</Layout>
