---
import MonsterPortrait from './Monster.astro';
import type { MonsterSummary } from '../lib/monster-catalog';
import {
  formLabel,
  leaderBonusText,
  leaderScopeText,
  leaderSkillIcon,
} from '../lib/monster-catalog';
interface Props {
  monster: MonsterSummary;
}
const { monster } = Astro.props;
const leaderIcon = leaderSkillIcon(monster.leaderSkill);
const leaderScope = leaderScopeText(monster.leaderSkill);
---

<a
  class="bestiary-card"
  href={`/monstros/${monster.id}/`}
  data-monster-card
  aria-label={`Ver ${monster.name}, ${formLabel(monster)}`}
>
  <div class="bestiary-card-top">
    <span
      class:list={[
        'natural-stars',
        {
          'natural-stars--awakened': monster.awakenLevel === 1,
          'natural-stars--second-awaken': monster.awakenLevel === 2,
        },
      ]}
      data-stars
      aria-label={`${monster.naturalStars} estrelas naturais`}
    >
      {'★'.repeat(monster.naturalStars)}
    </span>
    {monster.awakenLevel === 2 && (
      <span class="form-tag" data-form>
        {formLabel(monster)}
      </span>
    )}
  </div>
  <MonsterPortrait id={monster.id} />
  <span class="bestiary-family" data-family>
    {monster.family}
  </span>
  <span
    class="bestiary-leader"
    data-leader
    data-has-leader={monster.leaderSkill ? 'true' : 'false'}
  >
    <img
      class="bestiary-leader-icon"
      src={leaderIcon ?? undefined}
      alt=""
      width="40"
      height="40"
      loading="lazy"
      hidden={!leaderIcon}
      data-catalog-leader-icon
    />
    <span class="bestiary-leader-copy">
      <strong data-catalog-leader-primary>
        {leaderBonusText(monster.leaderSkill)}
      </strong>
      <small data-catalog-leader-context hidden={!leaderScope}>
        {leaderScope}
      </small>
    </span>
  </span>
</a>
