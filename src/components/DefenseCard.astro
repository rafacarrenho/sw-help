---
import type { Defense } from '../lib/types';
import { getCounters, searchText } from '../data/catalog';
import Team from './Team.astro';
import Icon from './Icon.astro';
import { getMessages, routePath, type Locale } from '../i18n';
import { localeCopy } from '../i18n/copy';
interface Props {
  defense: Defense;
  index: number;
  locale?: Locale;
}
const { defense, index, locale = 'pt-BR' } = Astro.props;
const messages = getMessages(locale);
const localCopy = localeCopy(locale);
const count = getCounters(defense.id).length;
---

<article
  class="defense-card"
  data-defense-card
  data-search={searchText(defense)}
  data-tower={defense.tower}
>
  <a class="defense-link" href={routePath('siege', locale, { id: defense.id })}>
    <div class="card-top">
      <span
        class={`tower-badge ${defense.tower === '4star' ? 'four-star' : ''}`}
      >
        <Icon name="tower" size={13} />
        {defense.tower === '4star'
          ? messages.siege.fourStarTower
          : messages.siege.openTower}
      </span>
      <span class="card-index">{String(index + 1).padStart(2, '0')}</span>
    </div>
    <Team team={defense.team} locale={locale} />
    <div class="card-bottom">
      <span>
        <Icon name="swords" size={15} />
        <strong>{count}</strong>{' '}
        {count === 1 ? localCopy.counter : localCopy.counters}
      </span>
      <span class="card-cta">
        {localCopy.viewDefense} <Icon name="arrow" size={16} />
      </span>
    </div>
  </a>
</article>
