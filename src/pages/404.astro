---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { getMessages, routePath, type Locale } from '../i18n';

const locale: Locale = Astro.url.pathname.startsWith('/pt/') ? 'pt-BR' : 'en';
const messages = getMessages(locale);
---

<Layout title={messages.notFound.title} locale={locale} noIndex>
  <div class="empty-state not-found">
    <span class="eyebrow">{messages.notFound.eyebrow}</span>
    <h1>{messages.notFound.heading}</h1>
    <p>{messages.notFound.copy}</p>
    <a class="button" href={routePath('home', locale)}>
      {messages.notFound.action} <Icon name="arrow" size={16} />
    </a>
  </div>
</Layout>
