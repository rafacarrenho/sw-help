---
import type { GetStaticPaths } from 'astro';
import SiegeDetail from '../../../../components/pages/SiegeDetail.astro';
import { defenses } from '../../../../data/catalog';

export const prerender = true;
export const getStaticPaths = (() =>
  defenses.map((defense) => ({
    params: { id: defense.id },
    props: { defense },
  }))) satisfies GetStaticPaths;
const { defense } = Astro.props;
---

<SiegeDetail defense={defense} locale="de" />
