---
import type { GetStaticPaths } from 'astro';
import SiegeDetail from '../../../components/pages/SiegeDetail.astro';
import { defensesFor } from '../../../data/catalog';

export const prerender = true;

export const getStaticPaths = (() =>
  defensesFor('pt-BR').map((defense) => ({
    params: { id: defense.id },
    props: { defense },
  }))) satisfies GetStaticPaths;
const { defense } = Astro.props;
---

<SiegeDetail defense={defense} locale="pt-BR" />
