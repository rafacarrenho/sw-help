---
import { monsters } from '../../../data/catalog';
import { routePath } from '../../../i18n';
import {
  PAGE_SIZE,
  filterMonsters,
  readMonsterFilters,
} from '../../../lib/monster-catalog';

export const prerender = true;

export function getStaticPaths() {
  return Array.from(
    {
      length:
        Math.ceil(
          filterMonsters(monsters, readMonsterFilters(new URLSearchParams()))
            .length / PAGE_SIZE,
        ) - 1,
    },
    (_, i) => ({ params: { page: String(i + 2) }, props: { page: i + 2 } }),
  );
}
const { page } = Astro.props;
return Astro.redirect(
  `${routePath('monsterPage', 'pt-BR', { page })}${Astro.url.search}`,
  301,
);
---
