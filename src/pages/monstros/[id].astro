---
import Layout from '../../layouts/Layout.astro';
import MonsterPortrait from '../../components/Monster.astro';
import MonsterCard from '../../components/MonsterCard.astro';
import Icon from '../../components/Icon.astro';
import {
  monsters,
  monsterById,
  defenses,
  counters,
  teamName,
  elementNames,
} from '../../data/catalog';
import { skillById } from '../../data/skill-catalog';
import metadata from '../../data/monsters-meta.json';
import {
  formLabel,
  leaderText,
  archetypeLabels,
} from '../../lib/monster-catalog';

export const prerender = true;

export function getStaticPaths() {
  return monsters.map((monster) => ({
    params: { id: monster.id },
    props: { monster },
  }));
}
const { monster } = Astro.props;
const monsterSkills = (monster.skillIds ?? [])
  .flatMap((id) => {
    const skill = skillById.get(id);
    return skill ? [skill] : [];
  })
  .sort((a, b) => a.slot - b.slot || a.id - b.id);
const stats = monster.maxLevelStats
  ? [
      ['HP máximo', monster.maxLevelStats.hp.toLocaleString('pt-BR')],
      ['ATQ máximo', monster.maxLevelStats.attack.toLocaleString('pt-BR')],
      ['DEF máxima', monster.maxLevelStats.defense.toLocaleString('pt-BR')],
      ['SPD base', String(monster.speed ?? '—')],
      ['Taxa crítica', `${monster.maxLevelStats.critRate}%`],
      ['Dano crítico', `${monster.maxLevelStats.critDamage}%`],
      ['Resistência', `${monster.maxLevelStats.resistance}%`],
      ['Precisão', `${monster.maxLevelStats.accuracy}%`],
    ]
  : [];
const family = monsters
  .filter((m) => m.familyId === monster.familyId && m.id !== monster.id)
  .sort(
    (a, b) =>
      a.element.localeCompare(b.element) ||
      (a.awakenLevel ?? 0) - (b.awakenLevel ?? 0),
  );
const evolution = (() => {
  let first = monster;
  while (first.awakensFrom) {
    const previous = monsterById.get(first.awakensFrom);
    if (!previous) break;
    first = previous;
  }

  const sequence = [first];
  let next = first.awakensTo ? monsterById.get(first.awakensTo) : null;

  while (next) {
    sequence.push(next);
    next = next.awakensTo ? monsterById.get(next.awakensTo) : null;
  }

  return sequence;
})();
const uses = defenses.filter(
  (d) =>
    d.team.includes(monster.id) ||
    counters.some((c) => c.defenseId === d.id && c.team.includes(monster.id)),
);
const updated = new Date(metadata.importedAt).toLocaleDateString('pt-BR', {
  timeZone: 'UTC',
});
---

<Layout
  title={`${monster.name} · ${elementNames[monster.element]}`}
  section="monsters"
  detail
  description={`${monster.name}, ${elementNames[monster.element]}, ${formLabel(monster)}: habilidade de líder, família e informações em Summoners War.`}
>
  <div class="detail-toolbar">
    <a class="back-link" href="/monstros/" data-back-monsters>
      <span>←</span> Todos os monstros
    </a>
  </div>
  <script is:inline>
    (() => {
      const current = new URLSearchParams(location.search);
      const back = new URLSearchParams();
      for (const key of ['q', 'element', 'stars', 'leader', 'sort']) {
        const value = current.get(key);
        if (value && !(key === 'sort' && value === 'name')) {
          back.set(key, value);
        }
      }
      const page = Math.max(1, Math.trunc(Number(current.get('page'))) || 1);
      const link = document.querySelector('[data-back-monsters]');
      if (!(link instanceof HTMLAnchorElement)) return;
      if (back.size) {
        if (page > 1) back.set('page', String(page));
        link.href = `/monstros/?${back}`;
      } else if (page > 1) {
        link.href = `/monstros/pagina/${page}/`;
      }
    })();
  </script>
  <section class="monster-profile">
    <div class="monster-profile-portrait">
      <MonsterPortrait id={monster.id} />
      {!monster.image && <span>Retrato indisponível na fonte</span>}
      <span
        class:list={[
          'natural-stars',
          {
            'natural-stars--awakened': monster.awakenLevel === 1,
            'natural-stars--second-awaken': monster.awakenLevel === 2,
          },
        ]}
        aria-label={`${monster.naturalStars} estrelas naturais`}
      >
        {'★'.repeat(monster.naturalStars)}
      </span>
      <span>Estrelas naturais</span>
    </div>
    <div class="monster-profile-content">
      <span class="eyebrow">{monster.family}</span>
      <h1>{monster.name}</h1>
      <div class="monster-profile-tags">
        <span>{elementNames[monster.element]}</span>
        {monster.awakenLevel === 2 && <span>{formLabel(monster)}</span>}
        <span>
          {archetypeLabels[monster.archetype ?? ''] ?? monster.archetype}
        </span>
      </div>
      <div class="monster-leader-panel">
        <span class="leader-emblem" aria-hidden="true">
          L
        </span>
        <div>
          <h2>Habilidade de líder</h2>
          <p>{leaderText(monster.leaderSkill)}</p>
        </div>
      </div>
      {stats.length > 0 && (
        <dl class="monster-facts" aria-label="Atributos do monstro">
          {stats.map(([label, value]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))}
        </dl>
      )}
      {monster.obtainable === false && (
        <p class="monster-availability">
          Esta forma está marcada como não obtível na base SWARFARM.
        </p>
      )}
      {evolution.length > 1 && (
        <div class="monster-evolution">
          <h2>Evolução</h2>
          <div class="monster-evolution-sequence">
            {evolution.map((stage, index) => (
              <>
                {index > 0 && (
                  <span class="monster-evolution-arrow" aria-hidden="true">
                    →
                  </span>
                )}
                <div class="monster-evolution-step">
                  {stage.image ? (
                    <img
                      src={stage.image}
                      alt={`${stage.name} (${formLabel(stage)})`}
                      width="64"
                      height="64"
                      loading="lazy"
                    />
                  ) : (
                    <span class="monster-evolution-fallback">
                      {stage.name.slice(0, 2)}
                    </span>
                  )}
                </div>
              </>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>
  {monsterSkills.length > 0 && (
    <section
      class="monster-related monster-skills"
      aria-labelledby="skills-title"
    >
      <div class="section-heading">
        <div>
          <h2 id="skills-title">Habilidades</h2>
          <p>Descrições originais fornecidas pelo SWARFARM.</p>
        </div>
        {typeof monster.skillUpsToMax === 'number' && (
          <span class="count-badge">
            {monster.skillUpsToMax} melhorias até o máximo
          </span>
        )}
      </div>
      <div class="monster-skill-list">
        {monsterSkills.map((skill) => (
          <article class="monster-skill-card">
            <div class="monster-skill-heading">
              <span class="monster-skill-slot">S{skill.slot}</span>
              <div>
                <h3>{skill.name}</h3>
                <div class="monster-skill-tags">
                  {skill.passive && <span>Passiva</span>}
                  {skill.aoe && <span>Área</span>}
                  {skill.random && <span>Alvo aleatório</span>}
                  {skill.cooltime !== null && (
                    <span>Recarga: {skill.cooltime} turnos</span>
                  )}
                  {skill.hits > 0 && (
                    <span>
                      {skill.hits} {skill.hits === 1 ? 'golpe' : 'golpes'}
                    </span>
                  )}
                </div>
              </div>
            </div>
            {skill.description && (
              <p class="monster-skill-description">{skill.description}</p>
            )}
            {skill.effects.length > 0 && (
              <ul class="monster-skill-effects">
                {skill.effects.map((effect) => (
                  <li>
                    <strong>{effect.name}</strong>
                    {effect.chance > 0 && (
                      <span>{effect.chance}% de chance</span>
                    )}
                    {effect.description && <p>{effect.description}</p>}
                    {effect.note && <small>{effect.note}</small>}
                  </li>
                ))}
              </ul>
            )}
            {(skill.multiplierFormula || skill.scalesWith.length > 0) && (
              <div class="monster-skill-scaling">
                {skill.multiplierFormula && (
                  <span>
                    Multiplicador: <code>{skill.multiplierFormula}</code>
                  </span>
                )}
                {skill.scalesWith.length > 0 && (
                  <span>Escala com: {skill.scalesWith.join(', ')}</span>
                )}
              </div>
            )}
            {skill.levelProgress.length > 0 && (
              <details class="monster-skill-progress">
                <summary>Progressão das melhorias</summary>
                <ol>
                  {skill.levelProgress.map((progress) => (
                    <li>{progress}</li>
                  ))}
                </ol>
              </details>
            )}
          </article>
        ))}
      </div>
    </section>
  )}
  {(monster.sources?.length ?? 0) > 0 && (
    <section
      class="monster-related monster-sources"
      aria-labelledby="sources-title"
    >
      <div class="section-heading">
        <div>
          <h2 id="sources-title">Como obter</h2>
          <p>Origens registradas para esta forma do monstro.</p>
        </div>
        <span class="count-badge">{monster.sources!.length}</span>
      </div>
      <ul class="monster-source-list">
        {monster.sources!.map((source) => (
          <li>
            <div>
              <strong>{source.name}</strong>
              {source.description && <p>{source.description}</p>}
            </div>
            {source.farmable && <span class="farmable-tag">Farmável</span>}
          </li>
        ))}
      </ul>
    </section>
  )}
  {uses.length > 0 && (
    <section class="monster-related" aria-labelledby="siege-uses-title">
      <div class="section-heading">
        <div>
          <h2 id="siege-uses-title">No Siege Counter</h2>
          <p>Defesas e estratégias do site que usam este monstro.</p>
        </div>
        <Icon name="swords" />
      </div>
      <div class="monster-uses">
        {uses.map((defense) => (
          <a href={`/siege/${defense.id}/`}>
            <span>{teamName(defense.team)}</span>
            <Icon name="arrow" size={18} />
          </a>
        ))}
      </div>
    </section>
  )}
  {family.length > 0 && (
    <section class="monster-related" aria-labelledby="family-title">
      <div class="section-heading">
        <div>
          <h2 id="family-title">Na mesma família</h2>
          <p>Outros elementos e formas para explorar.</p>
        </div>
        <span class="count-badge">{family.length}</span>
      </div>
      <div class="bestiary-grid">
        {family.map((relative) => (
          <MonsterCard monster={relative} />
        ))}
      </div>
    </section>
  )}
  <aside class="catalog-note">
    <Icon name="info" size={18} />
    <p>
      Dados do{' '}
      <a href={monster.source} target="_blank" rel="noreferrer">
        SWARFARM ↗
      </a>
      , importados em {updated}. Velocidade sem runas, torres ou bônus de líder.
      Retratos e personagens pertencem à Com2uS.
    </p>
  </aside>
</Layout>
