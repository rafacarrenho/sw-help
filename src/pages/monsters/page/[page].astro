---
import { monsters } from '../../../data/catalog';
import { routePath } from '../../../i18n';
import {
  PAGE_SIZE,
  filterMonsters,
  readMonsterFilters,
} from '../../../lib/monster-catalog';

export const prerender = true;

export function getStaticPaths() {
  return Array.from(
    {
      length:
        Math.ceil(
          filterMonsters(
            monsters,
            readMonsterFilters(new URLSearchParams()),
            'en',
          ).length / PAGE_SIZE,
        ) - 1,
    },
    (_, index) => ({
      params: { page: String(index + 2) },
      props: { page: index + 2 },
    }),
  );
}
const { page } = Astro.props;
return Astro.redirect(
  `${routePath('monsterPage', 'en', { page })}${Astro.url.search}`,
  301,
);
---
