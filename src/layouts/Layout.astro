---
import Icon from '../components/Icon.astro';
import GameContext from '../components/GameContext.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ThirdPartyScripts from '../components/ThirdPartyScripts.astro';
import PrivacyConsent from '../components/PrivacyConsent.astro';
import AdsterraSlot from '../components/AdsterraSlot.astro';
import { SITE_NAME, SITE_ORIGIN, SITE_TAGLINE } from '../config/site';
import { gameById, type GameId, type GameSection } from '../data/games';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/monsters.css';
import '../styles/speed-tick.css';
import '../styles/speed-tuning.css';
import '../styles/speed-comparison.css';
import {
  getMessages,
  localeMetadata,
  localeOptions,
  localizedHref,
  routePath,
  type Locale,
  type RouteName,
  type RouteParams,
} from '../i18n';
interface Props {
  title?: string;
  description?: string;
  detail?: boolean;
  locale?: Locale;
  routeName?: RouteName;
  routeParams?: RouteParams;
  noIndex?: boolean;
  breadcrumbLabel?: string;
  gameId?: GameId;
  section?: 'portal' | GameSection;
}
const {
  title = SITE_NAME,
  locale = 'en',
  detail = false,
  section = 'home',
  routeName = section === 'portal'
    ? 'portalHome'
    : section === 'siege'
      ? 'siegeCounter'
      : section === 'monsters'
        ? 'monsters'
        : section === 'speed-tick'
          ? 'speedTick'
          : section === 'speed-tuning'
            ? 'speedTuning'
            : section === 'speed-comparison'
              ? 'speedComparison'
              : 'home',
  routeParams = {},
  noIndex = false,
  breadcrumbLabel,
} = Astro.props;
const messages = getMessages(locale);
const portalRoutes = new Set<RouteName>([
  'portalHome',
  'about',
  'contact',
  'privacy',
  'terms',
]);
const activeGameId = portalRoutes.has(routeName)
  ? undefined
  : ((Astro.props.gameId ?? 'summoners-war') as GameId);
const activeGame = activeGameId ? gameById.get(activeGameId) : undefined;
const currentLanguage = localeMetadata[locale];
const languageOptions = localeOptions.filter(
  (option) => option.locale !== locale,
);
const description =
  Astro.props.description ?? messages.layout.defaultDescription;
const canonicalPath = routePath(routeName, locale, routeParams);
const canonicalUrl = new URL(canonicalPath, Astro.site ?? Astro.url.origin);
const portalUrl = new URL(
  routePath('portalHome', locale),
  Astro.site ?? Astro.url.origin,
);
const siteOrigin = Astro.site ?? new URL(SITE_ORIGIN);
const socialImageUrl = new URL(
  '/images/social/playerdojo-social.png',
  siteOrigin,
);
const organizationLogoUrl = new URL('/icon-512.png', siteOrigin);
const englishUrl = new URL(
  routePath(routeName, 'en', routeParams),
  Astro.site ?? Astro.url.origin,
);
const portugueseUrl = new URL(
  routePath(routeName, 'pt-BR', routeParams),
  Astro.site ?? Astro.url.origin,
);
const languageSearch = Astro.url.search;
const sectionRoute: RouteName =
  section === 'siege'
    ? 'siegeCounter'
    : section === 'monsters'
      ? 'monsters'
      : section === 'speed-tick'
        ? 'speedTick'
        : section === 'speed-tuning'
          ? 'speedTuning'
          : section === 'speed-comparison'
            ? 'speedComparison'
            : 'home';
const sectionLabel =
  section === 'monsters'
    ? messages.layout.monsters
    : section === 'speed-tick'
      ? 'Spd Tick'
      : section === 'speed-tuning'
        ? 'Spd Tuning'
        : section === 'speed-comparison'
          ? messages.layout.speedComparison
          : section === 'siege'
            ? 'Siege Counter'
            : messages.layout.home;
const documentTitle = title === SITE_NAME ? title : `${title} · ${SITE_NAME}`;
const structuredData: Record<string, unknown>[] = [];
const webApplicationRoutes = new Set<RouteName>([
  'siegeCounter',
  'monsters',
  'speedComparison',
  'speedTuning',
  'speedTick',
]);

if (routeName === 'portalHome') {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE_NAME,
    alternateName: `${SITE_NAME} · ${SITE_TAGLINE}`,
    url: canonicalUrl.href,
    description,
    inLanguage: locale === 'pt-BR' ? 'pt-BR' : 'en',
  });
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE_NAME,
    url: new URL('/', siteOrigin).href,
    logo: organizationLogoUrl.href,
    description: messages.layout.footerDescription,
  });
} else {
  const breadcrumbItems = [
    {
      '@type': 'ListItem',
      position: 1,
      name: messages.layout.home,
      item: portalUrl.href,
    },
  ];

  if (activeGame && routeName !== activeGame.homeRoute) {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: breadcrumbItems.length + 1,
      name: activeGame.name,
      item: new URL(
        routePath(activeGame.homeRoute, locale),
        Astro.site ?? Astro.url.origin,
      ).href,
    });
  }

  if (detail) {
    breadcrumbItems.push({
      '@type': 'ListItem',
      position: breadcrumbItems.length + 1,
      name: sectionLabel,
      item: new URL(
        routePath(sectionRoute, locale),
        Astro.site ?? Astro.url.origin,
      ).href,
    });
  }

  breadcrumbItems.push({
    '@type': 'ListItem',
    position: breadcrumbItems.length + 1,
    name:
      activeGame && routeName === activeGame.homeRoute
        ? activeGame.name
        : title,
    item: canonicalUrl.href,
  });
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: breadcrumbItems,
  });
}

if (webApplicationRoutes.has(routeName)) {
  structuredData.push({
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: title,
    url: canonicalUrl.href,
    description,
    applicationCategory:
      routeName === 'siegeCounter' || routeName === 'monsters'
        ? 'ReferenceApplication'
        : 'UtilitiesApplication',
    operatingSystem: 'Any',
    browserRequirements: 'Requires a modern web browser with JavaScript',
    isAccessibleForFree: true,
    inLanguage: locale === 'pt-BR' ? 'pt-BR' : 'en',
    offers: {
      '@type': 'Offer',
      price: 0,
      priceCurrency: 'USD',
    },
    isPartOf: {
      '@type': 'WebSite',
      name: SITE_NAME,
      url: portalUrl.href,
    },
  });
}

const serializedStructuredData = JSON.stringify(
  structuredData.length === 1 ? structuredData[0] : structuredData,
).replaceAll('<', '\\u003c');
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={
        noIndex
          ? 'noindex,follow'
          : 'index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1'
      }
    />
    <meta name="theme-color" content="#101215" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="PlayerDojo — Game Tools & Guides" />
    <meta property="og:locale" content={locale === 'en' ? 'en_US' : 'pt_BR'} />
    <meta
      property="og:locale:alternate"
      content={locale === 'en' ? 'pt_BR' : 'en_US'}
    />
    {!noIndex && (
      <>
        <meta property="og:url" content={canonicalUrl} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="alternate" hreflang="en" href={englishUrl} />
        <link rel="alternate" hreflang="pt-BR" href={portugueseUrl} />
        <link rel="alternate" hreflang="x-default" href={englishUrl} />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="PlayerDojo — Game Tools & Guides" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="icon" href="/icon-192.png" type="image/png" sizes="192x192" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <title>{documentTitle}</title>
    <ThirdPartyScripts placement="head" />
    {!noIndex && (
      <script
        type="application/ld+json"
        set:html={serializedStructuredData}
      ></script>
    )}
    <script is:inline>
      try {
        if (
          window.matchMedia('(min-width: 761px)').matches &&
          (window.localStorage.getItem('playerdojo:sidebar-collapsed') ??
            window.localStorage.getItem('sw-help:sidebar-collapsed')) === 'true'
        ) {
          document.documentElement.classList.add('nav-collapsed');
        }
      } catch {}
    </script>
  </head>
  <body
    data-open-menu={messages.layout.openMenu}
    data-close-menu={messages.layout.closeMenu}
    data-expand-sidebar={messages.layout.expandSidebar}
    data-collapse-sidebar={messages.layout.collapseSidebar}
  >
    <a class="skip-link" href="#main">
      {messages.layout.skip}
    </a>
    <header class="mobile-header">
      <button
        class="mobile-menu-toggle"
        type="button"
        aria-label={messages.layout.openMenu}
        aria-controls="app-sidebar"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <Icon name="menu" size={22} />
      </button>
      <a
        href={routePath('portalHome', locale)}
        class="mobile-brand"
        aria-label={messages.layout.homeLabel}
      >
        <span class="brand-symbol">
          <Icon name="swords" size={21} />
        </span>
        <span>
          Player<span class="brand-accent">Dojo</span>
        </span>
      </a>
      <span class="mobile-header-spacer" aria-hidden="true"></span>
    </header>
    <aside class="sidebar" id="app-sidebar" data-sidebar>
      <div class="sidebar-header">
        <a
          href={routePath('portalHome', locale)}
          class="brand"
          aria-label={messages.layout.homeLabel}
        >
          <span class="brand-symbol">
            <Icon name="swords" size={23} />
          </span>
          <span class="brand-copy">
            Player<span class="brand-accent">Dojo</span>
            <small>GAME TOOLS &amp; GUIDES</small>
          </span>
        </a>
        <button
          class="desktop-sidebar-toggle"
          type="button"
          aria-controls="app-sidebar"
          aria-expanded="true"
          aria-label={messages.layout.collapseSidebar}
          title={messages.layout.collapseSidebar}
          data-desktop-sidebar-toggle
        >
          <Icon name="chevron" size={16} />
        </button>
        <button
          class="mobile-menu-close"
          type="button"
          aria-label={messages.layout.closeMenu}
          data-mobile-menu-close
        >
          <Icon name="close" size={22} />
        </button>
      </div>
      {routeName === 'portalHome' && (
        <GameContext locale={locale} forceSelector placement="sidebar" />
      )}
      {activeGame && (
        <nav
          class="game-navigation"
          aria-label={`${activeGame.name} · ${messages.layout.tools}`}
        >
          {activeGame.navigation.map((item) => {
            const isActive = section === item.section;
            const isCurrentPage = isActive && !detail;
            return (
              <a
                class:list={['nav-item', { active: isActive }]}
                href={routePath(item.route, locale)}
                aria-label={item.label[locale]}
                data-nav-label={item.label[locale]}
                aria-current={isCurrentPage ? 'page' : undefined}
              >
                <Icon name={item.icon} />
                <span>{item.label[locale]}</span>
                {isActive && <span class="active-dot"></span>}
              </a>
            );
          })}
        </nav>
      )}
      <div class="sidebar-bottom">
        <nav
          class="language-switcher"
          aria-label={messages.layout.language}
          data-language-root
        >
          <span class="language-switcher-label">
            <Icon name="globe" size={18} />
            <span>{messages.layout.language}</span>
          </span>
          <div class="language-control">
            <button
              class="language-toggle"
              type="button"
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="language-menu"
              data-language-toggle
              data-nav-label={`${messages.layout.language}: ${currentLanguage.label}`}
            >
              <span class="language-flag" aria-hidden="true">
                {currentLanguage.flag}
              </span>
              <span class="language-current" lang={locale}>
                {currentLanguage.label}
              </span>
              <Icon name="chevron" size={14} class="language-chevron" />
            </button>
            <div
              class="language-menu"
              id="language-menu"
              role="menu"
              aria-label={messages.layout.language}
              data-language-menu
            >
              {languageOptions.map((option) => (
                <a
                  class="language-option"
                  href={localizedHref(
                    routeName,
                    option.locale,
                    routeParams,
                    languageSearch,
                  )}
                  lang={option.locale}
                  role="menuitem"
                  data-language-link
                >
                  <span class="language-flag" aria-hidden="true">
                    {option.flag}
                  </span>
                  <span>{option.label}</span>
                  <span class="language-abbreviation" aria-hidden="true">
                    {option.abbreviation}
                  </span>
                </a>
              ))}
            </div>
          </div>
        </nav>
      </div>
    </aside>
    <button
      class="sidebar-backdrop"
      type="button"
      aria-label={messages.layout.closeMenu}
      aria-hidden="true"
      tabindex="-1"
      data-sidebar-backdrop
    ></button>
    <div
      class="nav-tooltip"
      id="nav-tooltip"
      role="tooltip"
      aria-hidden="true"
      data-nav-tooltip
    ></div>
    <div class="workspace">
      <header class="topbar">
        <div class="topbar-inner">
          <div class="breadcrumb" aria-label="Breadcrumb">
            {breadcrumbLabel ? (
              <>
                <a href={routePath('portalHome', locale)}>
                  {messages.layout.home}
                </a>
                <Icon name="chevron" size={13} />
                {activeGame && (
                  <>
                    <a href={routePath(activeGame.homeRoute, locale)}>
                      {activeGame.name}
                    </a>
                    <Icon name="chevron" size={13} />
                  </>
                )}
                <span aria-current="page">{breadcrumbLabel}</span>
              </>
            ) : routeName === 'portalHome' ? (
              <span aria-current="page">{messages.layout.home}</span>
            ) : section === 'home' ? (
              <>
                <a href={routePath('portalHome', locale)}>
                  {messages.layout.home}
                </a>
                <Icon name="chevron" size={13} />
                <span aria-current="page">
                  {activeGame?.name ?? messages.layout.gameTools}
                </span>
              </>
            ) : (
              <>
                <a href={routePath('portalHome', locale)}>
                  {messages.layout.home}
                </a>
                <Icon name="chevron" size={13} />
                {activeGame && (
                  <>
                    <a href={routePath(activeGame.homeRoute, locale)}>
                      {activeGame.name}
                    </a>
                    <Icon name="chevron" size={13} />
                  </>
                )}
                {detail ? (
                  <>
                    <a href={routePath(sectionRoute, locale)}>{sectionLabel}</a>
                    <Icon name="chevron" size={13} />
                    <span class="breadcrumb-detail" aria-current="page">
                      {section === 'monsters'
                        ? messages.layout.monster
                        : messages.layout.defense}
                    </span>
                  </>
                ) : (
                  <span aria-current="page">{sectionLabel}</span>
                )}
              </>
            )}
          </div>
          <GameContext locale={locale} activeGame={activeGame} />
        </div>
      </header>
      <PrivacyConsent locale={locale} />
      <main id="main">
        <AdsterraSlot locale={locale} />
        <slot />
      </main>
      <SiteFooter locale={locale} />
    </div>
    <noscript>
      <style>
        .language-menu,
        .game-menu {
          position: static !important;
          display: grid !important;
          margin-top: 8px;
        }
        @media (max-width: 760px) {
          .mobile-header,
          .sidebar-backdrop,
          .desktop-sidebar-toggle,
          .mobile-menu-close {
            display: none !important;
          }
          .sidebar {
            position: relative !important;
            width: auto !important;
            height: auto !important;
            transform: none !important;
          }
        }
      </style>
    </noscript>
    <script>
      import '../scripts/search-clear';

      const currentSearch = window.location.search;
      if (currentSearch) {
        document
          .querySelectorAll<HTMLAnchorElement>('[data-language-link]')
          .forEach((link) => {
            const target = new URL(link.href, window.location.origin);
            target.search = currentSearch;
            link.href = `${target.pathname}${target.search}${target.hash}`;
          });
      }

      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      const languageRoot = document.querySelector<HTMLElement>(
        '[data-language-root]',
      );
      const languageToggle = document.querySelector<HTMLButtonElement>(
        '[data-language-toggle]',
      );
      const languageLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-language-link]'),
      );
      const gameRoot = document.querySelector<HTMLElement>('[data-game-root]');
      const gameToggle =
        document.querySelector<HTMLButtonElement>('[data-game-toggle]');
      const gameLinks = Array.from(
        document.querySelectorAll<HTMLAnchorElement>('[data-game-link]'),
      );
      const desktopToggle = document.querySelector<HTMLButtonElement>(
        '[data-desktop-sidebar-toggle]',
      );
      const mobileToggle = document.querySelector<HTMLButtonElement>(
        '[data-mobile-menu-toggle]',
      );
      const mobileClose = document.querySelector<HTMLButtonElement>(
        '[data-mobile-menu-close]',
      );
      const backdrop = document.querySelector<HTMLButtonElement>(
        '[data-sidebar-backdrop]',
      );
      const navTooltip =
        document.querySelector<HTMLElement>('[data-nav-tooltip]');
      const tooltipItems =
        document.querySelectorAll<HTMLElement>('[data-nav-label]');
      const mobileMedia = window.matchMedia('(max-width: 760px)');
      const navigationMessages = document.body.dataset;
      const navigationStorageKey = 'playerdojo:sidebar-collapsed';
      const legacyNavigationStorageKey = 'sw-help:sidebar-collapsed';
      const readDesktopPreference = () => {
        try {
          const currentPreference =
            window.localStorage.getItem(navigationStorageKey);
          if (currentPreference !== null) return currentPreference === 'true';

          const legacyPreference = window.localStorage.getItem(
            legacyNavigationStorageKey,
          );
          if (legacyPreference !== null) {
            window.localStorage.setItem(navigationStorageKey, legacyPreference);
            window.localStorage.removeItem(legacyNavigationStorageKey);
          }
          return legacyPreference === 'true';
        } catch {
          return false;
        }
      };
      const storeDesktopPreference = () => {
        try {
          window.localStorage.setItem(
            navigationStorageKey,
            String(desktopCollapsed),
          );
        } catch {}
      };
      let desktopCollapsed = readDesktopPreference();
      let mobileOpen = false;
      let tooltipOwner: HTMLElement | null = null;

      const closeGameMenu = (restoreFocus = false) => {
        if (!gameRoot || !gameToggle) return;
        gameRoot.removeAttribute('data-game-open');
        gameToggle.setAttribute('aria-expanded', 'false');
        if (restoreFocus) gameToggle.focus();
      };

      const openGameMenu = (focusFirstOption = false) => {
        if (!gameRoot || !gameToggle) return;
        closeLanguageMenu();
        hideNavTooltip();
        gameRoot.setAttribute('data-game-open', '');
        gameToggle.setAttribute('aria-expanded', 'true');
        if (focusFirstOption) {
          window.requestAnimationFrame(() => gameLinks[0]?.focus());
        }
      };

      const closeLanguageMenu = (restoreFocus = false) => {
        if (!languageRoot || !languageToggle) return;
        languageRoot.removeAttribute('data-language-open');
        languageToggle.setAttribute('aria-expanded', 'false');
        if (restoreFocus) languageToggle.focus();
      };

      const openLanguageMenu = (focusFirstOption = false) => {
        if (!languageRoot || !languageToggle) return;
        closeGameMenu();
        hideNavTooltip();
        languageRoot.setAttribute('data-language-open', '');
        languageToggle.setAttribute('aria-expanded', 'true');
        if (focusFirstOption) {
          window.requestAnimationFrame(() => languageLinks[0]?.focus());
        }
      };

      const hideNavTooltip = (owner?: HTMLElement) => {
        if (!navTooltip || (owner && tooltipOwner !== owner)) return;
        tooltipOwner?.removeAttribute('aria-describedby');
        tooltipOwner = null;
        navTooltip.classList.remove('is-visible');
        navTooltip.setAttribute('aria-hidden', 'true');
      };

      const showNavTooltip = (item: HTMLElement) => {
        if (
          !navTooltip ||
          !sidebar ||
          mobileMedia.matches ||
          !desktopCollapsed
        ) {
          return;
        }

        hideNavTooltip();
        const itemRect = item.getBoundingClientRect();
        const sidebarRect = sidebar.getBoundingClientRect();
        navTooltip.textContent = item.dataset.navLabel || '';
        navTooltip.style.left = `${sidebarRect.right + 12}px`;
        navTooltip.style.top = `${itemRect.top + itemRect.height / 2}px`;
        navTooltip.setAttribute('aria-hidden', 'false');
        navTooltip.classList.add('is-visible');
        item.setAttribute('aria-describedby', 'nav-tooltip');
        tooltipOwner = item;
      };

      const syncNavigation = () => {
        if (!sidebar || !desktopToggle || !mobileToggle) return;

        closeLanguageMenu();
        closeGameMenu();

        if (mobileMedia.matches) {
          document.documentElement.classList.remove('nav-collapsed');
          document.body.classList.toggle('mobile-nav-open', mobileOpen);
          mobileToggle.inert = mobileOpen;
          mobileToggle.setAttribute('aria-expanded', String(mobileOpen));
          mobileToggle.setAttribute(
            'aria-label',
            mobileOpen
              ? navigationMessages.closeMenu || ''
              : navigationMessages.openMenu || '',
          );
          sidebar.inert = !mobileOpen;
          sidebar.setAttribute('aria-hidden', String(!mobileOpen));
          sidebar.setAttribute('role', 'dialog');
          sidebar.setAttribute('aria-modal', 'true');
          return;
        }

        mobileOpen = false;
        hideNavTooltip();
        document.body.classList.remove('mobile-nav-open');
        document.documentElement.classList.toggle(
          'nav-collapsed',
          desktopCollapsed,
        );
        mobileToggle.inert = false;
        sidebar.inert = false;
        sidebar.removeAttribute('aria-hidden');
        sidebar.removeAttribute('role');
        sidebar.removeAttribute('aria-modal');
        desktopToggle.setAttribute('aria-expanded', String(!desktopCollapsed));
        desktopToggle.setAttribute(
          'aria-label',
          desktopCollapsed
            ? navigationMessages.expandSidebar || ''
            : navigationMessages.collapseSidebar || '',
        );
        desktopToggle.title = desktopCollapsed
          ? navigationMessages.expandSidebar || ''
          : navigationMessages.collapseSidebar || '';
      };

      const openMobileNavigation = () => {
        if (!mobileMedia.matches) return;
        mobileOpen = true;
        syncNavigation();
        window.requestAnimationFrame(() => mobileClose?.focus());
      };

      const closeMobileNavigation = (restoreFocus = true) => {
        if (!mobileOpen) return;
        mobileOpen = false;
        syncNavigation();
        if (restoreFocus) mobileToggle?.focus();
      };

      desktopToggle?.addEventListener('click', () => {
        desktopCollapsed = !desktopCollapsed;
        storeDesktopPreference();
        syncNavigation();
      });
      mobileToggle?.addEventListener('click', openMobileNavigation);
      mobileClose?.addEventListener('click', () => closeMobileNavigation());
      backdrop?.addEventListener('click', () => closeMobileNavigation());
      gameToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (gameRoot?.hasAttribute('data-game-open')) {
          closeGameMenu();
        } else {
          openGameMenu();
        }
      });
      gameToggle?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown') return;
        event.preventDefault();
        openGameMenu(true);
      });
      gameRoot?.addEventListener('keydown', (event) => {
        if (
          event.key !== 'Escape' ||
          !gameRoot.hasAttribute('data-game-open')
        ) {
          return;
        }
        event.preventDefault();
        event.stopPropagation();
        closeGameMenu(true);
      });
      gameLinks.forEach((link) => {
        link.addEventListener('click', () => closeGameMenu());
      });
      languageToggle?.addEventListener('click', (event) => {
        event.stopPropagation();
        if (languageRoot?.hasAttribute('data-language-open')) {
          closeLanguageMenu();
        } else {
          openLanguageMenu();
        }
      });
      languageToggle?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowDown') return;
        event.preventDefault();
        openLanguageMenu(true);
      });
      languageRoot?.addEventListener('keydown', (event) => {
        if (
          event.key !== 'Escape' ||
          !languageRoot.hasAttribute('data-language-open')
        ) {
          return;
        }
        event.preventDefault();
        event.stopPropagation();
        closeLanguageMenu(true);
      });
      languageLinks.forEach((link) => {
        link.addEventListener('click', () => closeLanguageMenu());
      });
      document.addEventListener('pointerdown', (event) => {
        if (!gameRoot?.contains(event.target as Node)) {
          closeGameMenu();
        }
        if (!languageRoot?.contains(event.target as Node)) {
          closeLanguageMenu();
        }
      });
      sidebar?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        link.addEventListener('click', () => closeMobileNavigation(false));
      });
      tooltipItems.forEach((item) => {
        item.addEventListener('mouseenter', () => showNavTooltip(item));
        item.addEventListener('mouseleave', () => hideNavTooltip(item));
        item.addEventListener('focus', () => showNavTooltip(item));
        item.addEventListener('blur', () => hideNavTooltip(item));
      });
      window.addEventListener('scroll', () => hideNavTooltip(), true);
      window.addEventListener('resize', () => hideNavTooltip());
      mobileMedia.addEventListener('change', () => {
        mobileOpen = false;
        syncNavigation();
      });
      document.addEventListener('keydown', (event) => {
        if (!mobileOpen || !sidebar) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeMobileNavigation();
          return;
        }
        if (event.key !== 'Tab') return;

        const focusable = Array.from(
          sidebar.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        ).filter((element) => !element.hidden);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      syncNavigation();

      document
        .querySelectorAll<HTMLImageElement>('.monster-portrait img')
        .forEach((img) => {
          const hide = () => {
            img.hidden = true;
          };
          img.addEventListener('error', hide);
          if (img.complete && img.naturalWidth === 0) hide();
        });
    </script>
  </body>
</html>
