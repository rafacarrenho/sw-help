---
import Icon from '../components/Icon.astro';
import '@fontsource-variable/dm-sans';
import '../styles/global.css';
import '../styles/monsters.css';
import '../styles/speed-tick.css';
interface Props {
  title?: string;
  description?: string;
  detail?: boolean;
  section?: 'siege' | 'monsters' | 'speed-tick';
}
const {
  title = 'Siege Counter',
  description = 'Encontre composições para enfrentar as defesas de Siege no Summoners War.',
  detail = false,
  section = 'siege',
} = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#101215" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title} · SW Help</title>
    <script is:inline>
      try {
        if (
          window.matchMedia('(min-width: 761px)').matches &&
          window.localStorage.getItem('sw-help:sidebar-collapsed') === 'true'
        ) {
          document.documentElement.classList.add('nav-collapsed');
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Pular para o conteúdo
    </a>
    <header class="mobile-header">
      <button
        class="mobile-menu-toggle"
        type="button"
        aria-label="Abrir menu"
        aria-controls="app-sidebar"
        aria-expanded="false"
        data-mobile-menu-toggle
      >
        <Icon name="menu" size={22} />
      </button>
      <a href="/" class="mobile-brand" aria-label="SW Help, início">
        <span class="brand-symbol">
          <Icon name="swords" size={21} />
        </span>
        <span>
          SW<span class="brand-help">HELP</span>
        </span>
      </a>
      <span class="mobile-header-spacer" aria-hidden="true"></span>
    </header>
    <aside class="sidebar" id="app-sidebar" data-sidebar>
      <div class="sidebar-header">
        <a href="/" class="brand" aria-label="SW Help, início">
          <span class="brand-symbol">
            <Icon name="swords" size={23} />
          </span>
          <span class="brand-copy">
            SW<span class="brand-help">HELP</span>
            <small>SUMMONERS WAR TOOLKIT</small>
          </span>
        </a>
        <button
          class="desktop-sidebar-toggle"
          type="button"
          aria-controls="app-sidebar"
          aria-expanded="true"
          aria-label="Recolher menu lateral"
          title="Recolher menu lateral"
          data-desktop-sidebar-toggle
        >
          <Icon name="chevron" size={16} />
        </button>
        <button
          class="mobile-menu-close"
          type="button"
          aria-label="Fechar menu"
          data-mobile-menu-close
        >
          <Icon name="close" size={22} />
        </button>
      </div>
      <div class="nav-group-label">SEU ARSENAL</div>
      <nav aria-label="Ferramentas">
        <a
          class:list={['nav-item', { active: section === 'siege' }]}
          href="/"
          aria-label="Siege Counter"
          data-nav-label="Siege Counter"
          aria-current={section === 'siege' && !detail ? 'page' : undefined}
        >
          <Icon name="swords" />
          <span>Siege Counter</span>
          {section === 'siege' && <span class="active-dot"></span>}
        </a>
        <a
          class:list={['nav-item', { active: section === 'monsters' }]}
          href="/monstros/"
          aria-label="Catálogo de Monstros"
          data-nav-label="Catálogo de Monstros"
          aria-current={section === 'monsters' && !detail ? 'page' : undefined}
        >
          <Icon name="book" />
          <span>Catálogo de Monstros</span>
          {section === 'monsters' && <span class="active-dot"></span>}
        </a>
        <button
          class="nav-item"
          aria-label="Spd Tuning · Em breve"
          data-nav-label="Spd Tuning · Em breve"
          disabled
        >
          <Icon name="speed" />
          <span>Spd Tuning</span>
          <small>Em breve</small>
        </button>
        <a
          class:list={['nav-item', { active: section === 'speed-tick' }]}
          href="/spd-tick/"
          aria-label="Spd Tick"
          data-nav-label="Spd Tick"
          aria-current={section === 'speed-tick' ? 'page' : undefined}
        >
          <Icon name="clock" />
          <span>Spd Tick</span>
          {section === 'speed-tick' && <span class="active-dot"></span>}
        </a>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-note">
          <span class="note-sigil">
            <Icon name="shield" size={24} />
          </span>
          <strong>Conhecimento é vantagem.</strong>
          <p>Prepare seu time antes de entrar na batalha.</p>
        </div>
        <span class="community-mark">
          <span class="status-dot"></span> Feito para a comunidade
        </span>
        <span class="version">
          SW HELP <span>v0.1</span>
        </span>
      </div>
    </aside>
    <button
      class="sidebar-backdrop"
      type="button"
      aria-label="Fechar menu"
      aria-hidden="true"
      tabindex="-1"
      data-sidebar-backdrop
    ></button>
    <div
      class="nav-tooltip"
      id="nav-tooltip"
      role="tooltip"
      aria-hidden="true"
      data-nav-tooltip
    ></div>
    <div class="workspace">
      <header class="topbar">
        <div class="breadcrumb">
          <span>Ferramentas</span>
          <Icon name="chevron" size={13} />
          <a href={section === 'monsters' ? '/monstros/' : '/'}>
            {section === 'monsters' ? 'Monstros' : 'Siege Counter'}
          </a>
          {detail && (
            <>
              <Icon name="chevron" size={13} />
              <span class="breadcrumb-detail">
                {section === 'monsters' ? 'Monstro' : 'Defesa'}
              </span>
            </>
          )}
        </div>
        <span class="game-tag">
          <span class="status-dot"></span> Summoners War
        </span>
      </header>
      <main id="main">
        <slot />
      </main>
      <footer>
        <span>
          SW Help <span class="footer-dot">·</span> Um toolkit de invocador para
          invocador.
        </span>
        <span>Projeto da comunidade. Sem vínculo com a Com2uS.</span>
      </footer>
    </div>
    <noscript>
      <style>
        @media (max-width: 760px) {
          .mobile-header,
          .sidebar-backdrop,
          .desktop-sidebar-toggle,
          .mobile-menu-close {
            display: none !important;
          }
          .sidebar {
            position: relative !important;
            width: auto !important;
            height: auto !important;
            transform: none !important;
          }
        }
      </style>
    </noscript>
    <script>
      const sidebar = document.querySelector<HTMLElement>('[data-sidebar]');
      const desktopToggle = document.querySelector<HTMLButtonElement>(
        '[data-desktop-sidebar-toggle]',
      );
      const mobileToggle = document.querySelector<HTMLButtonElement>(
        '[data-mobile-menu-toggle]',
      );
      const mobileClose = document.querySelector<HTMLButtonElement>(
        '[data-mobile-menu-close]',
      );
      const backdrop = document.querySelector<HTMLButtonElement>(
        '[data-sidebar-backdrop]',
      );
      const navTooltip =
        document.querySelector<HTMLElement>('[data-nav-tooltip]');
      const tooltipItems =
        document.querySelectorAll<HTMLElement>('[data-nav-label]');
      const mobileMedia = window.matchMedia('(max-width: 760px)');
      const navigationStorageKey = 'sw-help:sidebar-collapsed';
      const readDesktopPreference = () => {
        try {
          return window.localStorage.getItem(navigationStorageKey) === 'true';
        } catch {
          return false;
        }
      };
      const storeDesktopPreference = () => {
        try {
          window.localStorage.setItem(
            navigationStorageKey,
            String(desktopCollapsed),
          );
        } catch {}
      };
      let desktopCollapsed = readDesktopPreference();
      let mobileOpen = false;
      let tooltipOwner: HTMLElement | null = null;

      const hideNavTooltip = (owner?: HTMLElement) => {
        if (!navTooltip || (owner && tooltipOwner !== owner)) return;
        tooltipOwner?.removeAttribute('aria-describedby');
        tooltipOwner = null;
        navTooltip.classList.remove('is-visible');
        navTooltip.setAttribute('aria-hidden', 'true');
      };

      const showNavTooltip = (item: HTMLElement) => {
        if (
          !navTooltip ||
          !sidebar ||
          mobileMedia.matches ||
          !desktopCollapsed
        ) {
          return;
        }

        hideNavTooltip();
        const itemRect = item.getBoundingClientRect();
        const sidebarRect = sidebar.getBoundingClientRect();
        navTooltip.textContent = item.dataset.navLabel || '';
        navTooltip.style.left = `${sidebarRect.right + 12}px`;
        navTooltip.style.top = `${itemRect.top + itemRect.height / 2}px`;
        navTooltip.setAttribute('aria-hidden', 'false');
        navTooltip.classList.add('is-visible');
        item.setAttribute('aria-describedby', 'nav-tooltip');
        tooltipOwner = item;
      };

      const syncNavigation = () => {
        if (!sidebar || !desktopToggle || !mobileToggle) return;

        if (mobileMedia.matches) {
          document.documentElement.classList.remove('nav-collapsed');
          document.body.classList.toggle('mobile-nav-open', mobileOpen);
          mobileToggle.inert = mobileOpen;
          mobileToggle.setAttribute('aria-expanded', String(mobileOpen));
          mobileToggle.setAttribute(
            'aria-label',
            mobileOpen ? 'Fechar menu' : 'Abrir menu',
          );
          sidebar.inert = !mobileOpen;
          sidebar.setAttribute('aria-hidden', String(!mobileOpen));
          sidebar.setAttribute('role', 'dialog');
          sidebar.setAttribute('aria-modal', 'true');
          return;
        }

        mobileOpen = false;
        hideNavTooltip();
        document.body.classList.remove('mobile-nav-open');
        document.documentElement.classList.toggle(
          'nav-collapsed',
          desktopCollapsed,
        );
        mobileToggle.inert = false;
        sidebar.inert = false;
        sidebar.removeAttribute('aria-hidden');
        sidebar.removeAttribute('role');
        sidebar.removeAttribute('aria-modal');
        desktopToggle.setAttribute('aria-expanded', String(!desktopCollapsed));
        desktopToggle.setAttribute(
          'aria-label',
          desktopCollapsed ? 'Expandir menu lateral' : 'Recolher menu lateral',
        );
        desktopToggle.title = desktopCollapsed
          ? 'Expandir menu lateral'
          : 'Recolher menu lateral';
      };

      const openMobileNavigation = () => {
        if (!mobileMedia.matches) return;
        mobileOpen = true;
        syncNavigation();
        window.requestAnimationFrame(() => mobileClose?.focus());
      };

      const closeMobileNavigation = (restoreFocus = true) => {
        if (!mobileOpen) return;
        mobileOpen = false;
        syncNavigation();
        if (restoreFocus) mobileToggle?.focus();
      };

      desktopToggle?.addEventListener('click', () => {
        desktopCollapsed = !desktopCollapsed;
        storeDesktopPreference();
        syncNavigation();
      });
      mobileToggle?.addEventListener('click', openMobileNavigation);
      mobileClose?.addEventListener('click', () => closeMobileNavigation());
      backdrop?.addEventListener('click', () => closeMobileNavigation());
      sidebar?.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
        link.addEventListener('click', () => closeMobileNavigation(false));
      });
      tooltipItems.forEach((item) => {
        item.addEventListener('mouseenter', () => showNavTooltip(item));
        item.addEventListener('mouseleave', () => hideNavTooltip(item));
        item.addEventListener('focus', () => showNavTooltip(item));
        item.addEventListener('blur', () => hideNavTooltip(item));
      });
      window.addEventListener('scroll', () => hideNavTooltip(), true);
      window.addEventListener('resize', () => hideNavTooltip());
      mobileMedia.addEventListener('change', () => {
        mobileOpen = false;
        syncNavigation();
      });
      document.addEventListener('keydown', (event) => {
        if (!mobileOpen || !sidebar) return;
        if (event.key === 'Escape') {
          event.preventDefault();
          closeMobileNavigation();
          return;
        }
        if (event.key !== 'Tab') return;

        const focusable = Array.from(
          sidebar.querySelectorAll<HTMLElement>(
            'a[href], button:not([disabled]), [tabindex]:not([tabindex="-1"])',
          ),
        ).filter((element) => !element.hidden);
        const first = focusable[0];
        const last = focusable.at(-1);
        if (!first || !last) return;
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus();
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus();
        }
      });

      syncNavigation();

      document
        .querySelectorAll<HTMLImageElement>('.monster-portrait img')
        .forEach((img) => {
          const hide = () => {
            img.hidden = true;
          };
          img.addEventListener('error', hide);
          if (img.complete && img.naturalWidth === 0) hide();
        });
    </script>
  </body>
</html>
