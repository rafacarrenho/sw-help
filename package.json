{
  "name": "playerdojo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "assets:runes": "node scripts/build-rune-set-assets.mjs",
    "import:monsters": "node --experimental-strip-types scripts/import-monsters.mjs",
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.22.0"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource-variable/dm-sans": "^5.3.0",
    "astro": "^7.4.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.151.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1"
  }
}
